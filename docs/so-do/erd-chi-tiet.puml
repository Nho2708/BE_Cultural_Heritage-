    *id : bigint <<PK>>
    --
    *guest_device_id : bigint <<FK>>
    *activity_type : guest_activity_type
    heritage_id : bigint <<FK>>
    search_query : nvarchar(255)
    *language_code : language_code
    *created_at : datetime2(3)
  }
  entity ad_unlocks #EAD1DC {
    *id : bigint <<PK>>
    --
    *guest_device_id : bigint <<FK>>
    *heritage_id : bigint <<FK>>
    *platform : client_platform
    *ad_network : ad_network <<UK>>
    *transaction_id : nvarchar(255) <<UK>>
    ad_unit_id : nvarchar(100)
    *unlocked_at : datetime2(3)
    *expires_at : datetime2(3)
  }
}


@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam dpi 150
skinparam shadowing false
skinparam roundCorner 8
skinparam ArrowColor #333333
skinparam ArrowFontSize 12
skinparam ActivityBackgroundColor #F5F8FC
skinparam ActivityBorderColor #3B5B85
skinparam ActivityDiamondBackgroundColor #FFF6E5
skinparam ActivityDiamondBorderColor #B7791F
skinparam SwimlaneTitleFontStyle bold
skinparam StateBackgroundColor #F5F8FC
skinparam StateBorderColor #3B5B85
skinparam ComponentBackgroundColor #F5F8FC
skinparam ComponentBorderColor #3B5B85
skinparam NodeBackgroundColor #FFFFFF
skinparam NodeBorderColor #555555
skinparam DatabaseBackgroundColor #F5F8FC
skinparam CloudBackgroundColor #FFFFFF
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #3B5B85
skinparam ClassHeaderBackgroundColor #E8EEF6
skinparam PackageBorderColor #8A9BB3
skinparam nodesep 22
skinparam ranksep 50
skinparam componentStyle rectangle
skinparam ArrowFontSize 11
skinparam PackageStyle rectangle
skinparam ActorFontSize 12

actor "Team member (admin account)" as thanhVien
actor "System administrator, school administrator, teacher" as nguoiQuanTri
actor "Student, visitor" as nguoiHoc

rectangle "DiViet System" as heThong {
  package "Presentation tier" as tangTrinhBay {
    component "<b>Narration generator</b>\noffline tool, Python\nVieNeu-TTS, MeloTTS" as congCu
    component "<b>Admin Web</b>\nReact 19, Vite" as webQuanTri
    component "<b>Learning Web</b>\nReact 19, Vite" as webHocTap
    component "<b>Mobile App</b>\nReact Native, Expo" as app
  }
  package "Application tier" as tangUngDung {
    package "<b>Backend API</b> — ASP.NET Core 9" as backend {
      component "<b>API layer</b>\ncontrollers, JWT authentication, rate limiting, file serving" as lopApi
      component "<b>Application layer</b>\nuse case services, business rules, background jobs" as lopApp
      component "<b>Domain layer</b>\nentities, states, rules" as lopDomain
      component "<b>Infrastructure layer</b>\nEF Core, file storage, VNPay, SMTP, AI Service client" as lopInfra
    }
    component "<b>AI Service</b> — Python FastAPI\ntranslation and summary, lesson and question generation,\ncontent-based recommendations, VieNeu-TTS voice" as ai
  }
  package "Data tier" as tangDuLieu {
    database "<b>SQL Server 2019</b>\napplication database" as sql
    folder "<b>File storage</b>\nimages, 3D models, narration files, voice files" as kho
  }
}

rectangle "External systems" as heThongNgoai {
  component "Google Ad Manager" as adManager
  component "OpenStreetMap and OSRM" as osm
  component "Google AdMob" as admob
  component "LLM Provider (Google Gemini)" as llm
  component "VNPay Payment Gateway" as vnpay
  component "Email Service (SMTP)" as smtp
}

thanhVien --> congCu
nguoiQuanTri --> webQuanTri
nguoiHoc --> webHocTap
nguoiHoc --> app

congCu --> lopApi : narration MP3 upload (admin API, HTTPS)
webQuanTri --> lopApi : HTTPS, REST/JSON
webHocTap --> lopApi : HTTPS, REST/JSON
app --> lopApi : HTTPS, REST/JSON

lopApi --> lopApp
lopApp --> lopDomain
lopInfra ..|> lopApp
lopInfra --> sql : EF Core
lopInfra --> kho : read, write files
lopInfra --> ai : internal HTTP

ai --> llm : prompts, JSON results
lopInfra --> vnpay : payment request
vnpay --> lopApi : payment result (IPN)
lopInfra --> smtp : emails
webHocTap --> adManager : rewarded ads (web)
app --> admob : rewarded ads (app)
admob --> lopApi : reward verification
webHocTap --> osm : map tiles, routes
app --> osm : map tiles, routes
@enduml

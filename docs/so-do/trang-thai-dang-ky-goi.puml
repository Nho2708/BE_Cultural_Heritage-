@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam dpi 150
skinparam shadowing false
skinparam roundCorner 8
skinparam ArrowColor #333333
skinparam ArrowFontSize 12
skinparam ActivityBackgroundColor #F5F8FC
skinparam ActivityBorderColor #3B5B85
skinparam ActivityDiamondBackgroundColor #FFF6E5
skinparam ActivityDiamondBorderColor #B7791F
skinparam SwimlaneTitleFontStyle bold
skinparam StateBackgroundColor #F5F8FC
skinparam StateBorderColor #3B5B85
skinparam ComponentBackgroundColor #F5F8FC
skinparam ComponentBorderColor #3B5B85
skinparam NodeBackgroundColor #FFFFFF
skinparam NodeBorderColor #555555
skinparam DatabaseBackgroundColor #F5F8FC
skinparam CloudBackgroundColor #FFFFFF
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #3B5B85
skinparam ClassHeaderBackgroundColor #E8EEF6
skinparam PackageBorderColor #8A9BB3
hide empty description
state PENDING : Awaiting payment
state ACTIVE : Activated
state EXPIRED : Expired
state CANCELLED : Cancelled
[*] --> PENDING : School Administrator\nbuys, renews or\nupgrades a paid plan
[*] --> ACTIVE : System Administrator\ncreates the school\n(Free plan)
[*] --> ACTIVE : School Administrator\nactivates the Free plan\n[no effective or\nqueued plan]
PENDING --> ACTIVE : Successful VNPay IPN\n[valid signature,\nmatching amount]
PENDING --> CANCELLED : School Administrator\ncancels the\npurchase request
PENDING --> CANCELLED : Background job:\ninvoice overdue (24 h)\n[no pending payment]
ACTIVE --> CANCELLED : School Administrator\ncancels the current\npaid plan [plan started,\nno queued renewal]
ACTIVE --> CANCELLED : Successful VNPay IPN\nof an upgrade (current\nplan and queued\nrenewal cancelled)
ACTIVE --> EXPIRED : Daily background\njob at 00:05\n[end date passed]
CANCELLED --> ACTIVE : Late successful\nVNPay IPN [purchase\nrequest cancelled,\ninvoice not paid]
EXPIRED --> [*]
@enduml

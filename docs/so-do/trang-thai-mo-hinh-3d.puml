@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam dpi 150
skinparam shadowing false
skinparam roundCorner 8
skinparam ArrowColor #333333
skinparam ArrowFontSize 12
skinparam ActivityBackgroundColor #F5F8FC
skinparam ActivityBorderColor #3B5B85
skinparam ActivityDiamondBackgroundColor #FFF6E5
skinparam ActivityDiamondBorderColor #B7791F
skinparam SwimlaneTitleFontStyle bold
skinparam StateBackgroundColor #F5F8FC
skinparam StateBorderColor #3B5B85
skinparam ComponentBackgroundColor #F5F8FC
skinparam ComponentBorderColor #3B5B85
skinparam NodeBackgroundColor #FFFFFF
skinparam NodeBorderColor #555555
skinparam DatabaseBackgroundColor #F5F8FC
skinparam CloudBackgroundColor #FFFFFF
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #3B5B85
skinparam ClassHeaderBackgroundColor #E8EEF6
skinparam PackageBorderColor #8A9BB3
hide empty description
state "Model not removed" as MODEL {
  state DRAFT : Draft
  state PUBLISHED : Displayed
  state ARCHIVED : Hidden
  DRAFT --> PUBLISHED : System Administrator\nshows the model\n[no other model of\nthe site displayed]
  ARCHIVED --> PUBLISHED : System Administrator\nshows the model\n[no other model of\nthe site displayed]
  PUBLISHED --> ARCHIVED : System Administrator\nhides the model
  [*] --> DRAFT : System Administrator\nadds a model\n(display off)
  [*] --> PUBLISHED : System Administrator\nadds a model with display on\n[no other model of\nthe site displayed]
}
MODEL --> [*] : System Administrator\nremoves the model
@enduml

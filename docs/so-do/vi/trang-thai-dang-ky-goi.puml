@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam dpi 150
skinparam shadowing false
skinparam roundCorner 8
skinparam ArrowColor #333333
skinparam ArrowFontSize 12
skinparam ActivityBackgroundColor #F5F8FC
skinparam ActivityBorderColor #3B5B85
skinparam ActivityDiamondBackgroundColor #FFF6E5
skinparam ActivityDiamondBorderColor #B7791F
skinparam SwimlaneTitleFontStyle bold
skinparam StateBackgroundColor #F5F8FC
skinparam StateBorderColor #3B5B85
skinparam ComponentBackgroundColor #F5F8FC
skinparam ComponentBorderColor #3B5B85
skinparam NodeBackgroundColor #FFFFFF
skinparam NodeBorderColor #555555
skinparam DatabaseBackgroundColor #F5F8FC
skinparam CloudBackgroundColor #FFFFFF
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #3B5B85
skinparam ClassHeaderBackgroundColor #E8EEF6
skinparam PackageBorderColor #8A9BB3
hide empty description
state PENDING : Chờ thanh toán
state ACTIVE : Đã kích hoạt
state EXPIRED : Hết hạn
state CANCELLED : Đã hủy
[*] --> PENDING : Quản trị trường mua,\ngia hạn hoặc nâng cấp\ngói trả phí
[*] --> ACTIVE : Quản trị hệ thống\ntạo trường\n(gói Miễn phí)
[*] --> ACTIVE : Quản trị trường kích hoạt\ngói Miễn phí [không có gói\nhiệu lực hay gói chờ]
PENDING --> ACTIVE : IPN VNPay thành công\n[chữ ký hợp lệ,\nđúng số tiền]
PENDING --> CANCELLED : Quản trị trường\nhủy yêu cầu mua
PENDING --> CANCELLED : Tác vụ nền: hóa đơn\nquá hạn 24 giờ [không\ncòn giao dịch chờ]
ACTIVE --> CANCELLED : Quản trị trường hủy\ngói trả phí đang dùng\n[gói đã bắt đầu, không\ncó gói gia hạn chờ]
ACTIVE --> CANCELLED : IPN VNPay thành công\ncủa gói nâng cấp (hủy\ngói hiện tại và gói\ngia hạn chờ)
ACTIVE --> EXPIRED : Tác vụ nền 00:05\nhằng ngày [đã qua\nngày hết hạn]
CANCELLED --> ACTIVE : IPN VNPay thành công\nđến muộn [yêu cầu mua\nđã bị hủy, hóa đơn\nchưa trả]
EXPIRED --> [*]
@enduml

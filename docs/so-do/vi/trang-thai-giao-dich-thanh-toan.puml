@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam dpi 150
skinparam shadowing false
skinparam roundCorner 8
skinparam ArrowColor #333333
skinparam ArrowFontSize 12
skinparam ActivityBackgroundColor #F5F8FC
skinparam ActivityBorderColor #3B5B85
skinparam ActivityDiamondBackgroundColor #FFF6E5
skinparam ActivityDiamondBorderColor #B7791F
skinparam SwimlaneTitleFontStyle bold
skinparam StateBackgroundColor #F5F8FC
skinparam StateBorderColor #3B5B85
skinparam ComponentBackgroundColor #F5F8FC
skinparam ComponentBorderColor #3B5B85
skinparam NodeBackgroundColor #FFFFFF
skinparam NodeBorderColor #555555
skinparam DatabaseBackgroundColor #F5F8FC
skinparam CloudBackgroundColor #FFFFFF
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #3B5B85
skinparam ClassHeaderBackgroundColor #E8EEF6
skinparam PackageBorderColor #8A9BB3
hide empty description
state PENDING : Chờ kết quả
state SUCCEEDED : Thành công
state FAILED : Thất bại
[*] --> PENDING : Quản trị trường bấm Thanh toán\n(mua, gia hạn, nâng cấp hoặc\ntrả hóa đơn chưa trả)
PENDING --> SUCCEEDED : IPN VNPay thành công\n[chữ ký hợp lệ,\nđúng số tiền]
PENDING --> FAILED : IPN VNPay báo\nkhông thành công\n[chữ ký hợp lệ,\nđúng số tiền]
PENDING --> FAILED : Tác vụ nền: quá\n30 phút chưa có IPN
PENDING --> FAILED : Quản trị trường thanh\ntoán lại hóa đơn hoặc\nhủy yêu cầu mua
FAILED --> SUCCEEDED : IPN VNPay thành công\nđến muộn [giao dịch do\nhệ thống đánh thất bại]
SUCCEEDED --> [*]
@enduml

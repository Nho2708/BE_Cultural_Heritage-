@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam dpi 150
skinparam shadowing false
skinparam roundCorner 8
skinparam ArrowColor #333333
skinparam ArrowFontSize 12
skinparam ActivityBackgroundColor #F5F8FC
skinparam ActivityBorderColor #3B5B85
skinparam ActivityDiamondBackgroundColor #FFF6E5
skinparam ActivityDiamondBorderColor #B7791F
skinparam SwimlaneTitleFontStyle bold
skinparam StateBackgroundColor #F5F8FC
skinparam StateBorderColor #3B5B85
skinparam ComponentBackgroundColor #F5F8FC
skinparam ComponentBorderColor #3B5B85
skinparam NodeBackgroundColor #FFFFFF
skinparam NodeBorderColor #555555
skinparam DatabaseBackgroundColor #F5F8FC
skinparam CloudBackgroundColor #FFFFFF
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #3B5B85
skinparam ClassHeaderBackgroundColor #E8EEF6
skinparam PackageBorderColor #8A9BB3
skinparam nodesep 22
skinparam ranksep 50
skinparam componentStyle rectangle
skinparam ArrowFontSize 11
skinparam PackageStyle rectangle
skinparam ActorFontSize 12

actor "Thành viên nhóm (tài khoản quản trị)" as thanhVien
actor "Quản trị hệ thống, quản trị trường, giáo viên" as nguoiQuanTri
actor "Học sinh, khách tham quan" as nguoiHoc

rectangle "Hệ thống DiViet" as heThong {
  package "Tầng trình bày" as tangTrinhBay {
    component "<b>Công cụ tạo thuyết minh</b>\nchạy ngoài máy chủ, Python\nVieNeu-TTS, MeloTTS" as congCu
    component "<b>Web quản trị</b>\nReact 19, Vite" as webQuanTri
    component "<b>Web học tập</b>\nReact 19, Vite" as webHocTap
    component "<b>App mobile</b>\nReact Native, Expo" as app
  }
  package "Tầng ứng dụng" as tangUngDung {
    package "<b>Backend API</b> — ASP.NET Core 9" as backend {
      component "<b>Lớp API</b>\ncontroller, xác thực JWT, giới hạn tần suất, phát tệp" as lopApi
      component "<b>Lớp Application</b>\ndịch vụ theo use case, quy tắc nghiệp vụ, tác vụ nền" as lopApp
      component "<b>Lớp Domain</b>\nthực thể, trạng thái, quy tắc" as lopDomain
      component "<b>Lớp Infrastructure</b>\nEF Core, kho tệp, VNPay, SMTP, gọi Dịch vụ AI" as lopInfra
    }
    component "<b>Dịch vụ AI</b> — Python FastAPI\ndịch và tóm tắt, soạn bài, sinh câu hỏi,\ngợi ý theo nội dung, giọng đọc VieNeu-TTS" as ai
  }
  package "Tầng dữ liệu" as tangDuLieu {
    database "<b>SQL Server 2019</b>\ncơ sở dữ liệu ứng dụng" as sql
    folder "<b>Kho tệp</b>\nảnh, mô hình 3D, tệp thuyết minh, tệp giọng đọc" as kho
  }
}

rectangle "Hệ thống ngoài" as heThongNgoai {
  component "Google Ad Manager" as adManager
  component "OpenStreetMap và OSRM" as osm
  component "Google AdMob" as admob
  component "Nhà cung cấp mô hình ngôn ngữ (Google Gemini)" as llm
  component "Cổng thanh toán VNPay" as vnpay
  component "Dịch vụ email (SMTP)" as smtp
}

thanhVien --> congCu
nguoiQuanTri --> webQuanTri
nguoiHoc --> webHocTap
nguoiHoc --> app

congCu --> lopApi : tệp thuyết minh MP3 (API quản trị, HTTPS)
webQuanTri --> lopApi : HTTPS, REST/JSON
webHocTap --> lopApi : HTTPS, REST/JSON
app --> lopApi : HTTPS, REST/JSON

lopApi --> lopApp
lopApp --> lopDomain
lopInfra ..|> lopApp
lopInfra --> sql : EF Core
lopInfra --> kho : đọc, ghi tệp
lopInfra --> ai : HTTP nội bộ

ai --> llm : lời nhắc, kết quả JSON
lopInfra --> vnpay : yêu cầu thanh toán
vnpay --> lopApi : kết quả thanh toán (IPN)
lopInfra --> smtp : thư điện tử
webHocTap --> adManager : quảng cáo có thưởng (web)
app --> admob : quảng cáo có thưởng (app)
admob --> lopApi : xác minh phần thưởng
webHocTap --> osm : ảnh nền bản đồ, tuyến đường
app --> osm : ảnh nền bản đồ, tuyến đường
@enduml

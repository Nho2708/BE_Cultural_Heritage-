@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam dpi 150
skinparam shadowing false
skinparam roundCorner 8
skinparam ArrowColor #333333
skinparam ArrowFontSize 12
skinparam ActivityBackgroundColor #F5F8FC
skinparam ActivityBorderColor #3B5B85
skinparam ActivityDiamondBackgroundColor #FFF6E5
skinparam ActivityDiamondBorderColor #B7791F
skinparam SwimlaneTitleFontStyle bold
skinparam StateBackgroundColor #F5F8FC
skinparam StateBorderColor #3B5B85
skinparam ComponentBackgroundColor #F5F8FC
skinparam ComponentBorderColor #3B5B85
skinparam NodeBackgroundColor #FFFFFF
skinparam NodeBorderColor #555555
skinparam DatabaseBackgroundColor #F5F8FC
skinparam CloudBackgroundColor #FFFFFF
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #3B5B85
skinparam ClassHeaderBackgroundColor #E8EEF6
skinparam PackageBorderColor #8A9BB3

skinparam nodesep 10
skinparam ranksep 14
skinparam packageStyle rectangle
skinparam ClassFontSize 18
skinparam ClassAttributeFontSize 17
skinparam ClassStereotypeFontSize 17
skinparam package {
  FontStyle bold
  FontSize 20
  BorderColor #555555
}
hide circle

package "Nhóm 1 · Auth / Tổ chức" as pkg_1 #F4F0F7 {
  entity organizations #E1D5E7 {
    id (PK)
  }
  entity roles #E1D5E7 {
    id (PK)
  }
  entity users #E1D5E7 {
    id (PK)
    --
    organization_id (FK)
    role_id (FK)
  }
  entity password_reset_tokens #E1D5E7 {
    id (PK)
    --
    user_id (FK)
  }
  entity audit_logs #E1D5E7 {
    id (PK)
    --
    user_id (FK)
  }
}

package "Nhóm 2 · Lớp / Học sinh" as pkg_2 #FFEDF6 {
  entity classes #FFCCE6 {
    id (PK)
    --
    organization_id (FK)
    teacher_id (FK)
  }
  entity students #FFCCE6 {
    id (PK)
    --
    class_id (FK)
    user_id (FK)
  }
  entity student_notifications #FFCCE6 {
    id (PK)
    --
    student_id (FK)
    lesson_id (FK)
    quiz_id (FK)
    sent_by (FK)
  }
}

package "Nhóm 3 · Di sản" as pkg_3 #F0F7F0 {
  entity provinces #D5E8D4 {
    id (PK)
  }
  entity heritages #D5E8D4 {
    id (PK)
    --
    province_id (FK)
  }
  entity timelines #D5E8D4 {
    id (PK)
    --
    heritage_id (FK)
  }
  entity events #D5E8D4 {
    id (PK)
    --
    timeline_id (FK)
  }
  entity media #D5E8D4 {
    id (PK)
    --
    heritage_id (FK)
    event_id (FK)
  }
  entity heritage_references #D5E8D4 {
    id (PK)
    --
    heritage_id (FK)
  }
}

package "Nhóm 4 · Bài học + AI" as pkg_4 #F2F7FE {
  entity lessons #DAE8FC {
    id (PK)
    --
    teacher_id (FK)
    class_id (FK)
  }
  entity lesson_heritages #DAE8FC {
    lesson_id (PK, FK)
    heritage_id (PK, FK)
  }
  entity ai_generations #DAE8FC {
    id (PK)
    --
    lesson_id (FK)
    heritage_id (FK)
    requested_by (FK)
  }
  entity lesson_sections #DAE8FC {
    id (PK)
    --
    lesson_id (FK)
    event_id (FK)
  }
}

package "Nhóm 5 · Ngân hàng câu hỏi" as pkg_5 #FFF6ED {
  entity questions #FFE6CC {
    id (PK)
    --
    heritage_id (FK)
    created_by (FK)
    ai_generation_id (FK)
    reviewed_by (FK)
  }
  entity answers #FFE6CC {
    id (PK)
    --
    question_id (FK)
  }
}

package "Nhóm 6 · Quiz" as pkg_6 #FFFAED {
  entity quizzes #FFF2CC {
    id (PK)
    --
    lesson_id (FK)
    created_by (FK)
  }
  entity quiz_questions #FFF2CC {
    quiz_id (PK, FK)
    question_id (PK, FK)
  }
}

package "Nhóm 7 · Làm bài / Kết quả" as pkg_7 #E3F5F6 {
  entity attempts #B0E3E6 {
    id (PK)
    --
    quiz_id (FK)
    student_id (FK)
  }
  entity attempt_answers #B0E3E6 {
    id (PK)
    --
    attempt_id (FK)
    question_id (FK)
    answer_id (FK)
  }
  entity attempt_answer_parts #B0E3E6 {
    id (PK)
    --
    attempt_answer_id (FK)
    answer_id (FK)
    selected_answer_id (FK)
  }
  entity lesson_completions #B0E3E6 {
    id (PK)
    --
    student_id (FK)
    lesson_id (FK)
  }
  entity lesson_visits #B0E3E6 {
    id (PK)
    --
    student_id (FK)
    lesson_id (FK)
  }
}

package "Nhóm 8 · Thanh toán" as pkg_8 #FDEEED {
  entity plans #F8CECC {
    id (PK)
  }
  entity subscriptions #F8CECC {
    id (PK)
    --
    organization_id (FK)
    plan_id (FK)
  }
  entity invoices #F8CECC {
    id (PK)
    --
    organization_id (FK)
    subscription_id (FK)
  }
  entity payment_providers #F8CECC {
    id (PK)
  }
  entity payments #F8CECC {
    id (PK)
    --
    invoice_id (FK)
    provider_id (FK)
  }
}

package "Nhóm 9 · Đa ngôn ngữ và 3D" as pkg_9 #F7F6F6 {
  entity heritage_translations #E7E6E6 {
    id (PK)
    --
    heritage_id (FK)
    ai_generation_id (FK)
    reviewed_by (FK)
  }
  entity timeline_translations #E7E6E6 {
    id (PK)
    --
    timeline_id (FK)
  }
  entity event_translations #E7E6E6 {
    id (PK)
    --
    event_id (FK)
  }
  entity media_translations #E7E6E6 {
    id (PK)
    --
    media_id (FK)
  }
  entity heritage_summaries #E7E6E6 {
    id (PK)
    --
    heritage_id (FK)
    ai_generation_id (FK)
    reviewed_by (FK)
  }
  entity heritage_models #E7E6E6 {
    id (PK)
    --
    heritage_id (FK)
  }
  entity heritage_narrations #E7E6E6 {
    id (PK)
    --
    heritage_id (FK)
  }
  entity speech_clips #E7E6E6 {
    id (PK)
  }
}

package "Nhóm 10 · Khách tham quan và quảng cáo" as pkg_10 #F8EFF3 {
  entity guest_devices #EAD1DC {
    id (PK)
  }
  entity guest_activities #EAD1DC {
    id (PK)
    --
    guest_device_id (FK)
    heritage_id (FK)
  }
  entity ad_unlocks #EAD1DC {
    id (PK)
    --
    guest_device_id (FK)
    heritage_id (FK)
  }
}


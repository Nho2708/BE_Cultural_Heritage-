@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam dpi 150
skinparam shadowing false
skinparam roundCorner 8
skinparam ArrowColor #333333
skinparam ArrowFontSize 12
skinparam ActivityBackgroundColor #F5F8FC
skinparam ActivityBorderColor #3B5B85
skinparam ActivityDiamondBackgroundColor #FFF6E5
skinparam ActivityDiamondBorderColor #B7791F
skinparam SwimlaneTitleFontStyle bold
skinparam StateBackgroundColor #F5F8FC
skinparam StateBorderColor #3B5B85
skinparam ComponentBackgroundColor #F5F8FC
skinparam ComponentBorderColor #3B5B85
skinparam NodeBackgroundColor #FFFFFF
skinparam NodeBorderColor #555555
skinparam DatabaseBackgroundColor #F5F8FC
skinparam CloudBackgroundColor #FFFFFF
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #3B5B85
skinparam ClassHeaderBackgroundColor #E8EEF6
skinparam PackageBorderColor #8A9BB3
hide empty description
state IN_PROGRESS : In progress
state SUBMITTED : Submitted
state EXPIRED : Time up,\nsubmitted by the system
[*] --> IN_PROGRESS : Student starts the quiz\n[quiz open,\nno attempt yet]
IN_PROGRESS --> IN_PROGRESS : Level 1 student checks a question (first\ncheck is scored, later checks do not\nchange the saved answer)
IN_PROGRESS --> SUBMITTED : Student submits [within deadline\nplus 30 seconds; Level 1 has\nno deadline]
IN_PROGRESS --> EXPIRED : Student submits, saves or checks\nan answer, or reopens [after\ndeadline plus 30 seconds]
IN_PROGRESS --> EXPIRED : Background job\nevery minute\n[after deadline\nplus 30 seconds]
IN_PROGRESS --> EXPIRED : Quiz closed\n(by the Teacher or\nthe background job)
SUBMITTED --> [*]
EXPIRED --> [*]
@enduml

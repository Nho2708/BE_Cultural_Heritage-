<?xml version="1.0" encoding="utf-8"?>
<!--
  Cấu hình IIS của API (máy demo). Lúc publish, SDK điền processPath và arguments.
  Bỏ WebDAV: IIS có cài WebDAV thì mô-đun này chặn mọi yêu cầu DELETE (và một số PUT) bằng 405 trước khi tới ứng dụng,
  làm hỏng các API xoá (gỡ ảnh, xoá mục, gỡ mô hình 3D...).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
